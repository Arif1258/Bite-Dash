# ==========================================
# MASTER BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Copy and configure these for each microservice under `services/`
# ==========================================

# Port the specific microservice runs on (Defaults: auth=5000, restaurant=5001, utils=5002, realtime=5004, rider=5005, admin=5006)
PORT=5000

# MongoDB Connection String (Used by auth, admin, restaurant, rider)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# Database Name (Used by admin)
DB_NAME=Zomato_Clone

# JWT Secret Token (Used by auth, admin, restaurant, rider, realtime)
JWT_SEC=your_jwt_secret_token_here

# Google OAuth Credentials (Used by auth)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OpenAI GenAI Agent Configuration (Used by restaurant service)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Microservice Inter-communication Security Key (Must match across all services & frontend)
INTERNAL_SERVICE_KEY=jdfienf12345@@@@##4$$$%%%jsadfjlajdf

# RabbitMQ Message Broker Endpoint (Used by utils, restaurant, rider)
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# RabbitMQ Message Queues (Used by utils, restaurant, rider)
PAYMENT_QUEUE=payment_event
RIDER_QUEUE=rider_queue
ORDER_READY_QUEUE=order_ready_queue

# Cloudinary Storage Credentials (Used by utils)
CLOUD_NAME=your_cloudinary_name_here
CLOUD_API_KEY=your_cloudinary_api_key_here
CLOUD_SECRET_KEY=your_cloudinary_secret_key_here

# Stripe Gateway Credentials (Used by utils)
STRIPE_SECRET_KEY=sk_test_your_secret_stripe_key_here

# Razorpay Gateway Credentials (Used by utils)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Application Redirection URL (Used by utils)
FRONTEND_URL=http://localhost:5173

# Microservice Dependency Base Endpoints
AUTH_SERVICE=http://localhost:5000
RESTAURANT_SERVICE=http://localhost:5001
UTILS_SERVICE=http://localhost:5002
REALTIME_SERVICE=http://localhost:5004
RIDER_SERVICE=http://localhost:5005
ADMIN_SERVICE=http://localhost:5006
