# Stripe Publishable Key for payments
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Internal key to authenticate requests (must match the backend's INTERNAL_SERVICE_KEY)
VITE_INTERNAL_SERVICE_KEY=your_internal_service_key_token_here

# Google OAuth Client ID (moved from hardcoded value in main.tsx)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Microservice Endpoints (moved from hardcoded values in main.tsx)
VITE_AUTH_SERVICE_URL=http://localhost:5000
VITE_RESTAURANT_SERVICE_URL=http://localhost:5001
VITE_UTILS_SERVICE_URL=http://localhost:5002
VITE_REALTIME_SERVICE_URL=http://localhost:5004
VITE_RIDER_SERVICE_URL=http://localhost:5005
VITE_ADMIN_SERVICE_URL=http://localhost:5006
